<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Needed to scan for BLE OBD adapters: many cheap BLE ELM327 clones don't support
         classic Bluetooth pairing/bonding at all, so they never show up in the bonded-devices
         list and can only be found via a live BLE scan. neverForLocation is safe here - we
         only use scan results to list/connect to a device, never to derive location. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:ignore="UnusedAttribute" />
    <!-- Location: pre-31 BLE scanning, and the nearby-charger list on the SoC hero tile
         (position is sent to the public OpenStreetMap Overpass API). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- POI category + MAP_TEMPLATES grants MapWithContentTemplate, whose map surface
         (ACCESS_SURFACE) DashboardScreen draws the dashboard on. -->
    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />

    <uses-feature android:name="android.hardware.bluetooth" android:required="true" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.software.car.templates_host" android:required="false" />

    <application
        android:allowBackup="true"
        android:name=".App"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.EvCompanion"
        android:supportsRtl="true">

        <activity
            android:name=".phone.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.EvCompanion">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".core.polling.ObdPollingService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Must be exported (and unprotected by a permission) so the Android Auto/Automotive
             OS host can bind to it - access is controlled by createHostValidator() instead. -->
        <service
            android:name=".car.EvCompanionCarAppService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <!-- POI: the app lists nearby EV chargers (DashboardScreen's content panel) and
                     hands taps off to the driver's navigation app. Not NAVIGATION, so it doesn't
                     claim "navigate to..." voice requests and isn't Play-gated when sideloaded. -->
                <category android:name="androidx.car.app.category.POI" />
            </intent-filter>
        </service>

        <!-- Lets the "Share debug log" action hand DebugFileLogger's output to the share sheet
             (email, Drive, Files, etc.) as a content:// URI, without needing USB/adb at all. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="7" /> <!-- MapWithContentTemplate -->

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

    </application>

</manifest>
