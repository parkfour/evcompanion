{
  "customPids": [
    {
      "name": "Requested Charge Power",
      "shortName": "Req Power",
      "header": "7E4",
      "modeAndPid": "0x220101",
      "formula": "(((m<8)+n)/10 * ((h<8)+i)/10) / 1000",
      "unit": "kW",
      "min": 0,
      "max": 360
    }
  ],
  "detailViews": {
    "pack_power_detail": {
      "label": "Pack Power",
      "panels": [
        { "type": "dial", "pidNames": ["Battery Power"], "label": "POWER", "gaugeRange": [-270, 270] },
        { "type": "value", "pidNames": ["Battery DC Voltage"], "label": "VOLTAGE" },
        { "type": "value", "pidNames": ["Battery Current"], "label": "CURRENT" }
      ]
    },
    "motor_rpm_detail": {
      "label": "Motor RPM",
      "panels": [
        { "type": "dial", "pidNames": ["Drive Motor Speed Front"], "label": "FRONT", "gaugeRange": [-10100, 10100] },
        { "type": "dial", "pidNames": ["Drive Motor Speed Rear"], "label": "REAR", "gaugeRange": [-10100, 10100] }
      ]
    },
    "charging_vi_detail": {
      "label": "Voltage / Current",
      "panels": [
        { "type": "dial", "pidNames": ["Battery DC Voltage"], "label": "VOLTS", "gaugeRange": [0, 800] },
        { "type": "dial", "pidNames": ["Battery Current"], "label": "AMPS", "negate": true, "gaugeRange": [0, 350] }
      ]
    },
    "charging_hero_overlay": {
      "label": "Charging Overview",
      "panels": [
        { "type": "graph", "label": "SOC / ACTUAL / REQ / MIN TEMP", "windowSeconds": 300, "normalizePerSeries": true, "series": [
          { "pidNames": ["State of Charge Display", "SOC"], "label": "SOC", "color": "#3CC864" },
          { "pidNames": ["Battery Power"], "label": "ACTUAL", "negate": true, "color": "#4696E6" },
          { "pidNames": ["Requested Charge Power", "000_Requested Charge Power"], "label": "REQ kW", "color": "#FFB300" },
          { "pidNames": ["Battery Min Temperature"], "label": "MIN TEMP", "color": "#5AAAFF" }
        ] }
      ]
    }
  },
  "pages": [
